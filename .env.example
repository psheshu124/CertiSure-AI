# ==========================================
# CERTISURE AI — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Frontend Supabase Client (Vite-exposed)
# Replace with your Supabase Project URL and Publishable (anon) API Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# 2. Server-Side AI Integration (Server-only, NEVER exposed to client)
# Replace with your Google Gemini API key (from Google AI Studio)
GEMINI_API_KEY=your-google-gemini-api-key

# 3. Server Configuration (Optional)
PORT=3001
VITE_PORT=5173
NODE_ENV=development

# 4. Local Development Auth Admin (Optional, Server-only, NEVER exposed to client)
# Used only to confirm developer test accounts locally via scripts/confirm_test_user.js
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# DEV_ADMIN_SECRET=certisure-dev-local-secret
